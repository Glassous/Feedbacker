# ---------- 服务 ----------
# 宿主机映射端口
PORT=9090
# 管理后台与页面标题展示的名称
SITE_NAME=Feedbacker
# 管理员用户名（首次启动时创建）
ADMIN_USERNAME=admin

# ---------- 数据库 ----------
MONGO_DB=feedbacker
# docker compose 默认连接内置 mongo；连接外部数据库时修改为完整 URI
# MONGO_URI=mongodb://user:password@host:27017/?authSource=admin

# ---------- 安全 ----------
# JWT 签名密钥；留空时自动生成并持久化到 MongoDB
JWT_SECRET=
# 登录令牌有效期（小时）
JWT_TTL_HOURS=12
# 公开提交接口的共享密钥；留空表示不校验
FEEDBACK_API_KEY=
# 允许跨域调用接口的来源（管理后台、接入方站点），逗号分隔；* 表示允许所有来源
# 例：CORS_ORIGINS=https://feedbackeradmin.vodyanitsa.top
CORS_ORIGINS=*
# 部署在 Nginx/Caddy 等反向代理之后时设为 true
TRUST_PROXY=false
# 每个 IP 每分钟允许提交的反馈数量
RATE_LIMIT_PER_MINUTE=60

# ---------- 日志 ----------
# debug / info / warn / error
LOG_LEVEL=info

# ---------- 镜像 ----------
VERSION=local
TZ=Asia/Shanghai
